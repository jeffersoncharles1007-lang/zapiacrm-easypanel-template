# =============================================================================
# ZAPIACRM — Variaveis de ambiente (template)
#
# Copie este arquivo para .env.local para rodar localmente. No deploy (Vercel),
# defina no painel: Project → Settings → Environment Variables.
#
# QUANTIDADE: 18 vars no total (13 obrigatorias, 5 opcionais)
# CUSTO OPERACIONAL: R$ 0/mes em todos os planos free tier
# =============================================================================


# ===== SUPABASE (5) — obrigatorias =====
# Criadas automaticamente pela integracao Vercel <-> Supabase OU copiadas
# manualmente do Supabase Dashboard → Settings → API.
SUPABASE_URL=                               # https://[seu-projeto].supabase.co
SUPABASE_PUBLISHABLE_KEY=                   # "anon key" do Supabase
SUPABASE_SERVICE_ROLE_KEY=                  # segredo do backend (NUNCA vai pro browser)
SUPABASE_PROJECT_ID=                        # ref do projeto (ex: icwecwngrrlkgeziwihj)
POSTGRES_URL_NON_POOLING=                   # connection string DDL (opcional, so p/ build)

# ===== VITE_* mirror (3) — obrigatorias =====
# Geradas automaticamente no build por scripts/vercel-build.mjs a partir das
# vars acima. Se rodar local sem script, copie manualmente:
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=


# ===== GOOGLE GEMINI (1) — obrigatoria =====
# IA usada pelo agente (chat, briefing, prompt). Gratis ate rate limit.
# Onde gerar: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=


# ===== EVOLUTION API (2) — obrigatorias =====
# WhatsApp multi-device. A Evolution API e GRATIS e open source
# (github.com/EvolutionAPI/evolution-api). Voce so paga o VPS
# onde ela roda 24/7 (~R$ 30/mes). Cada cliente seu precisa do
# VPS DELE — Evolution nao pode ser compartilhada entre clientes.
# Setup completo: ver MANUAL.md cap 6.
EVOLUTION_API_URL=                          # https://evolution.seudominio.com
EVOLUTION_API_KEY=                          # key gerada no painel Evolution


# ===== SMTP (6) — obrigatorias =====
# Titan, Gmail Workspace, Zoho, etc. Porta 465 (SSL) ou 587 (TLS).
# Setup completo: ver MANUAL.md cap 5.
SMTP_HOST=                                  # mail.seudominio.com.br
SMTP_PORT=465                               # 465 SSL ou 587 TLS
SMTP_USER=                                  # noreply@seudominio.com.br
SMTP_PASS=                                  # senha do email (ou app password)
SMTP_SENDER_EMAIL=                          # mesmo do SMTP_USER
SMTP_SENDER_NAME=                           # "Seu Produto"


# ===== BILLING WEBHOOKS (3) — OPCIONAIS =====
# Gere cada token no painel do provedor (Apps/Webhooks) e cole aqui.
# Se nao for usar pagamento, deixe vazio (webhook retorna 401).
# Setup completo: ver MANUAL.md cap 7.
KIWIFY_WEBHOOK_TOKEN=
CAKTO_WEBHOOK_TOKEN=
PERFECTPAY_WEBHOOK_TOKEN=


# ===== APP CONFIG (1) — obrigatoria =====
# URL do seu deploy, sem barra final. Usada para callbacks e CORS.
APP_ORIGIN=                                 # https://seudominio.com.br

# ===== LEAD WEBHOOK (1) — OPCIONAL =====
# Dispara POST fire-and-forget apos signup com payload contendo
# email/nome/whatsapp/company_id. Use para integrar com GoHighLevel,
# Make, Zapier, planilha, CRM, etc.
LEAD_WEBHOOK_URL=                            # https://seu-webhook.com/endpoint